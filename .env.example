# Configura tu base de datos PostgreSQL (por ejemplo Neon o Supabase).
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE_DE_DATOS?sslmode=require
# Contraseña de estudiantes (cámbiala en producción si se difunde).
CLASS_PASSWORD=Mariscal Sucre
# Contraseña EXCLUSIVA del docente: utiliza una distinta, larga y privada.
ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CLAVE_LARGA_Y_PRIVADA
# Genera una clave aleatoria segura (32+ bytes) para firmar las sesiones.
SESSION_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_MUY_LARGO
# Gestión activa; opcional (si falta se usa el año actual)
SCHOOL_YEAR=2026
PORT=3000
